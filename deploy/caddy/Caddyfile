# Data Hub reverse proxy. install.sh replaces HOSTNAME with the Pi's hostname.
# Caddy's internal CA issues the certificate; each phone and laptop trusts the
# root once (download it from https://HOSTNAME.local/ca.crt).

HOSTNAME.local {
	tls internal

	handle /signalk* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /ca.crt {
		root * /etc/data-hub/public
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}
}

# Plain HTTP on the LAN only redirects to HTTPS.
http://HOSTNAME.local {
	redir https://{host}{uri} permanent
}
