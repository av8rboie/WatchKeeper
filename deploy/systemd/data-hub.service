[Unit]
Description=Data Hub (catamaran instruments, logbook, maintenance)
After=network.target signalk.service
Wants=signalk.service

[Service]
Type=notify
# The backend sends READY and WATCHDOG=1 through the systemd-notify helper,
# which runs as a child process, so notifications from any process are accepted.
NotifyAccess=all
User=datahub
Group=datahub
EnvironmentFile=/etc/data-hub/data-hub.env
WorkingDirectory=/opt/data-hub/current/server
ExecStart=/usr/bin/node /opt/data-hub/current/server/dist/main.js
Restart=always
RestartSec=2
WatchdogSec=30
TimeoutStartSec=60
TimeoutStopSec=20

ProtectSystem=strict
ReadWritePaths=/var/lib/data-hub
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
